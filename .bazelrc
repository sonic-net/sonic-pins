common --registry=https://raw.githubusercontent.com/sonic-net/sonic-bazel-registry/main
common --registry=https://bcr.bazel.build
common --lockfile_mode=update
common --noincompatible_disallow_empty_glob
common --incompatible_strict_action_env
common --legacy_external_runfiles

# Execute and target Debian Trixie using the shared sonic-build-infra toolchains.
common --platforms=@sonic_build_infra//platforms:x86_64_trixie
common --host_platform=@sonic_build_infra//platforms:x86_64_trixie
common:aarch64 --platforms=@sonic_build_infra//platforms:aarch64_trixie
common:aarch64 --host_platform=@sonic_build_infra//platforms:aarch64_trixie

# Build sonic-swss-common with its YANG C++ sources and schema generator.
common --@sonic_swss_common//tools/bazel:yang_modules=True

# Match Trixie libswsscommon ABI and upstream PINS warning tolerances.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
run --cxxopt=-std=c++20
run --host_cxxopt=-std=c++20
build --copt=-Wno-error=sign-compare
build --host_copt=-Wno-error=sign-compare
run --copt=-Wno-error=sign-compare
run --host_copt=-Wno-error=sign-compare
build --copt=-Wno-array-bounds
build --copt=-Wno-stringop-overflow

# Match sonic-buildimage gRPC settings.
build --@com_github_grpc_grpc//:disable_grpc_rls=true

build:release --compilation_mode=opt
test --test_output=errors

try-import %workspace%/.bazelrc.user
