"""SONiC PINS (P4 Integrated Network Stack) Bzlmod configuration."""

module(
    name = "sonic-pins",
    version = "0.0.0",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

# SONiC infrastructure and platform dependencies aligned with sonic-buildimage.
bazel_dep(
    name = "sonic-build-infra",
    version = "0.0.40-e3d21fce8c3e06f3635bbddd92f1807b3f66d3c1",
    repo_name = "sonic_build_infra",
)
bazel_dep(
    name = "sonic-swss-common",
    version = "0.0.9-334389eae54afd1f4f5ee69f89c3a7ad2062ee61",
    repo_name = "sonic_swss_common",
)
bazel_dep(name = "libnl3", version = "3.7.0.sonic.8")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")

bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.22", dev_dependency = True)

bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.1")

bazel_dep(name = "rules_rs", version = "0.1.0", dev_dependency = True)
bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2", dev_dependency = True)

# C++ and P4 dependencies from Bazel Central Registry and sonic-bazel-registry.
bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "boost.bimap", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.graph", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.math", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.multiprecision", version = "1.90.0.bcr.1")
bazel_dep(name = "envoy_api", version = "0.0.0-20260901-005c18a.bcr.1")

bazel_dep(name = "google_benchmark", version = "1.9.5", dev_dependency = True, repo_name = "com_google_benchmark")

bazel_dep(name = "googleapis", version = "0.0.0-20260223-edfe7983", repo_name = "com_google_googleapis")

bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True, repo_name = "com_google_googletest")

bazel_dep(name = "grpc", version = "1.81.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "gutil", version = "20260309.0.sonic.1", repo_name = "com_google_gutil")

bazel_dep(name = "jsoncpp", version = "1.9.6.bcr.1", dev_dependency = True, repo_name = "com_jsoncpp")

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")

bazel_dep(name = "openconfig_gnmi", version = "0.14.1", dev_dependency = True, repo_name = "com_github_gnmi")
bazel_dep(name = "openconfig_gnoi", version = "0.6.2", dev_dependency = True, repo_name = "com_github_gnoi")

bazel_dep(name = "p4_constraints", version = "20260909.0.sonic.1", repo_name = "com_github_p4lang_p4_constraints")
bazel_dep(name = "p4c", version = "1.2.4.2.sonic.7", repo_name = "com_github_p4lang_p4c")
bazel_dep(name = "p4runtime", version = "1.6.0")
bazel_dep(name = "protobuf", version = "33.5", repo_name = "com_google_protobuf")
bazel_dep(name = "re2", version = "2024-07-02.bcr.1", repo_name = "com_googlesource_code_re2")

bazel_dep(name = "z3", version = "4.15.2", dev_dependency = True, repo_name = "com_github_z3prover_z3")

bazel_dep(name = "boringssl", version = "0.20250818.0")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.3",
    dev_dependency = True,
)

# Root overrides matching sonic-buildimage so standalone and image graphs agree.
single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

single_version_override(
    module_name = "libnl3",
    version = "3.7.0.sonic.8",
)

single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

single_version_override(
    module_name = "sonic-rust-deps",
    version = "0.0.5-5bf69bc0a7d9ea9f4a5606264be592867cd29d1e",
)

# p4_constraints@20260909.0.sonic.1 declares p4c@1.2.5.11; pin SONiC's p4c 1.2.4.2.
single_version_override(
    module_name = "p4c",
    version = "1.2.4.2.sonic.7",
)

# Preserve toolchain sysroot include flags and real execroot for BCR Z3 CMake build.
single_version_override(
    module_name = "z3",
    patch_strip = 1,
    patches = ["//bazel:patches/z3-toolchain.patch"],
    version = "4.15.2",
)

# Standalone toolchains (root-only; image builds provide their own).
python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
use_repo(python, "python_3_13")

register_toolchains(
    "@python_3_13//:all",
    dev_dependency = True,
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc", dev_dependency = True)
use_repo(gcc, "gcc_toolchains")

register_toolchains(
    "@gcc_toolchains//:all",
    dev_dependency = True,
)

register_toolchains(
    "@sonic_build_infra//tools/gzip:toolchain",
    dev_dependency = True,
)

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains", dev_dependency = True)
use_repo(tar_toolchains, "bsd_tar_toolchains")

register_toolchains(
    "@bsd_tar_toolchains//:all",
    dev_dependency = True,
)

# Keep rules_rs toolchain registration in root (dev-only) so bazel mod graph
# satisfies rules_rust's root-module lookup triggered via sonic-swss-common.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust", dev_dependency = True)
use_repo(rules_rust, "rules_rust")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen", dev_dependency = True)
use_repo(bindgen, "rules_rust_bindgen")

register_toolchains(
    "@rules_rust_bindgen//:all",
    dev_dependency = True,
)

# Locked Debian snapshot libraries exported by sonic-build-infra for standalone dev targets.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt", dev_dependency = True)
use_repo(apt, "p4c_deps")

# Non-BCR OTG proto dependency hosted on GitHub (tests/lib/dvaas only).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "com_github_otg_models",
    build_file = "//bazel:BUILD.otg-models.bazel",
    dev_dependency = True,
    sha256 = "1a63e769f1d7f42c79bc1115babf54acbc44761849a77ac28f47a74567f10090",
    strip_prefix = "models-0.12.5",
    url = "https://github.com/open-traffic-generator/models/archive/refs/tags/v0.12.5.zip",
)
