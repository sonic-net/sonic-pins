package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

exports_files([
    "debian/changelog",
    "debian/compat",
    "debian/control",
])

p4rt_version = "0.0.1"

p4rt_maintainer = "PINS Working Group <pins-wg@opennetworking.org>"

_RUNTIME_DEPENDS = [
    "libswsscommon",
    "libhiredis1.1.0",
    "libnl-3-200",
    "libnl-genl-3-200",
]

# These installed tools are production programs. Keep the measurement-test
# executable in the unchanged legacy/test bundle below.
_PRODUCTION_BINARIES = [
    ":p4rt",
    "//p4rt_app/scripts:p4rt_program_table",
    "//p4rt_app/scripts:p4rt_read",
    "//p4rt_app/scripts:p4rt_set_forwarding_pipeline",
    "//p4rt_app/scripts:p4rt_write",
]

cc_binary(
    name = "p4rt",
    srcs = ["p4rt.cc"],
    copts = ["-std=c++20"],
    dynamic_deps = [
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_genl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
    ],
    deps = [
        "//p4rt_app/event_monitoring:app_state_db_port_table_event",
        "//p4rt_app/event_monitoring:app_state_db_send_to_ingress_port_table_event",
        "//p4rt_app/event_monitoring:config_db_node_cfg_table_event",
        "//p4rt_app/event_monitoring:config_db_port_table_event",
        "//p4rt_app/event_monitoring:config_db_queue_table_event",
        "//p4rt_app/event_monitoring:debug_data_dump_events",
        "//p4rt_app/event_monitoring:state_event_monitor",
        "//p4rt_app/event_monitoring:state_verification_events",
        "//p4rt_app/event_monitoring:warm_boot_events",
        "//p4rt_app/p4runtime:p4runtime_impl",
        "//p4rt_app/sonic:packetio_impl",
        "//p4rt_app/sonic:redis_connections",
        "//p4rt_app/sonic/adapters:consumer_notifier_adapter",
        "//p4rt_app/sonic/adapters:notification_producer_adapter",
        "//p4rt_app/sonic/adapters:producer_state_table_adapter",
        "//p4rt_app/sonic/adapters:subscriber_state_table_adapter",
        "//p4rt_app/sonic/adapters:system_call_adapter",
        "//p4rt_app/sonic/adapters:table_adapter",
        "//p4rt_app/sonic/adapters:warm_boot_state_adapter",
        "//p4rt_app/sonic/adapters:zmq_producer_state_table_adapter",
        "//p4rt_app/utils:warm_restart_utility",
        "@com_github_grpc_grpc//:grpc++",
        "@com_github_grpc_grpc//:grpc++_authorization_provider",
        "@com_github_grpc_grpc//:grpc_security_base",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/functional:bind_front",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:initialize",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/synchronization",
        "@com_google_absl//absl/time",
        "@com_google_gutil//gutil:status",
        "@com_google_gutil//gutil:syslog_sink",
        "@p4runtime//proto/p4/config/v1:p4info_cc_proto",
        "@sonic_swss_common//:libswsscommon_shared",
    ],
)

# Source-owned OCI inputs built natively with stripped ELF binaries and
# paired .build-id debug symbols (:p4rt_runtime.debug_symbols).
sonic_deploy_tar(
    name = "p4rt_runtime",
    binaries = {
        "usr/local/bin/" + binary.split(":")[-1] + " type=file uid=0 gid=0 mode=0755 time=0": binary
        for binary in _PRODUCTION_BINARIES
    },
    force_debug_build = True,
    mtree = [
        ". type=dir uid=0 gid=0 mode=0755 time=0",
        "usr type=dir uid=0 gid=0 mode=0755 time=0",
        "usr/local type=dir uid=0 gid=0 mode=0755 time=0",
        "usr/local/bin type=dir uid=0 gid=0 mode=0755 time=0",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)

runtime_packages(
    name = "runtime_packages.json",
    changelog = "//p4rt_app:debian/changelog",
    control = "//p4rt_app:debian/control",
    debian_files = {"compat": "//p4rt_app:debian/compat"},
    dependencies = [
        "@libnl3//:runtime_packages.json",
        "@sonic_swss_common//:runtime_packages.json",
    ],
    module_name = "sonic-pins",
    packages = {"sonic-p4rt": ":p4rt_runtime"},
    required_paths = {
        "sonic-p4rt": [
            "usr/local/bin/" + binary.split(":")[-1]
            for binary in _PRODUCTION_BINARIES
        ],
    },
)

py_test(
    name = "runtime_package_test",
    timeout = "long",
    srcs = ["runtime_package_test.py"],
    args = [
        "--runtime",
        "$(rootpath :p4rt_runtime)",
        "--debug",
        "$(rootpath :p4rt_runtime.debug_symbols)",
        "--metadata",
        "$(rootpath :runtime_packages.json)",
    ],
    data = [
        "p4rt.cc",
        ":p4rt_runtime",
        ":p4rt_runtime.debug_symbols",
        ":runtime_packages.json",
        "//p4rt_app/scripts:p4rt_program_table.cc",
        "//p4rt_app/scripts:p4rt_read.cc",
        "//p4rt_app/scripts:p4rt_set_forwarding_pipeline.cc",
        "//p4rt_app/scripts:p4rt_write.cc",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_genl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@sonic_swss_common//:libswsscommon_shared",
    ],
    python_version = "PY3",
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)

# Manual legacy Debian packages backed by the same stripped runtime ELF and
# .build-id split symbol TARs used by OCI assembly.
pkg_deb(
    name = "p4rt_deb",
    architecture = "amd64",
    data = ":p4rt_runtime",
    depends = _RUNTIME_DEPENDS,
    description = "P4RT service",
    maintainer = p4rt_maintainer,
    package = "sonic-p4rt",
    tags = ["manual"],
    version = p4rt_version,
)

pkg_deb(
    name = "p4rt_dbg_deb",
    architecture = "amd64",
    data = ":p4rt_runtime.debug_symbols",
    depends = [
        "sonic-p4rt (= " + p4rt_version + ")",
    ],
    description = "P4RT service debug symbols",
    maintainer = p4rt_maintainer,
    package = "sonic-p4rt-dbgsym",
    tags = ["manual"],
    version = p4rt_version,
)
